<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Widget" layer="HUD" position="0 0 300 200" name="_Main" align="Stretch">

        <Widget type="TextBox" skin="SandBrightText" position="8 6 56 22" name="FpsText" align="Left Top">
            <Property key="NeedMouse" value="false"/>
            <Property key="TextAlign" value="Left"/>
            <Property key="TextShadow" value="true"/>
            <Property key="TextShadowColour" value="0 0 0"/>
            <Property key="FontName" value="Russo"/>
            <Property key="Caption" value="0"/>
        </Widget>

        <Widget type="TextBox" skin="SandBrightText" position="76 6 84 22" name="PingText" align="Left Top">
            <Property key="NeedMouse" value="false"/>
            <Property key="TextAlign" value="Left"/>
            <Property key="TextShadow" value="true"/>
            <Property key="TextShadowColour" value="0 0 0"/>
            <Property key="FontName" value="Russo"/>
            <Property key="Caption" value="-- ms"/>
        </Widget>

        <Widget type="Widget" skin="" position="45 156 210 12" align="Bottom Center" name="EnemyHealthFrame">
            <Property key="Visible" value="false"/>
            <Widget type="Widget" skin="MW_Box" position="0 0 210 12" align="Stretch" name="EnemyHealthBorder">
                <Widget type="ProgressBar" skin="MW_EnergyBar_Yellow" position="2 2 206 8" align="Stretch" name="EnemyHealth">
                    <Property key="NeedMouse" value="false"/>
                    <Property key="Visible" value="false"/>
                </Widget>
            </Widget>
        </Widget>

        <Widget type="Button" skin="" position="100 170 200 28" align="Left Bottom" name="MagickaFrame">
            <UserString key="ToolTipType" value="Layout"/>
            <UserString key="ToolTipLayout" value="HealthToolTip"/>
            <UserString key="ImageTexture_HealthImage" value="icons\k\magicka.dds"/>

            <Widget type="Widget" skin="MW_Box" position="0 0 170 16" align="Left Bottom" name="MagickaBorder">
                <Widget type="ProgressBar" skin="MW_EnergyBar_Blue" position="2 2 166 12" align="Stretch" name="Magicka">
                    <Property key="NeedMouse" value="false"/>
                </Widget>
                <Widget type="TextBox" skin="SandBrightText" position="0 0 170 16" align="Stretch" name="MagickaText">
                    <Property key="NeedMouse" value="false"/>
                    <Property key="TextAlign" value="Center"/>
                    <Property key="TextShadow" value="true"/>
                    <Property key="TextShadowColour" value="0 0 0"/>
                    <Property key="Caption" value="0/0"/>
                </Widget>
            </Widget>

            <Widget type="Widget" skin="MW_Box" position="0 20 170 8" align="Left Bottom" name="SpellStatusBorder">
                <Widget type="ProgressBar" skin="MW_EnergyBar_Magic" position="2 2 166 4" align="Stretch" name="SpellStatus">
                    <Property key="NeedMouse" value="false"/>
                </Widget>
            </Widget>

            <Widget type="Button" skin="" position="179 0 21 21" align="Left Bottom" name="SpellBox">
                <Widget type="Widget" skin="MW_Box" position="0 0 21 21" align="Stretch" name="SpellIconFrame">
                    <Widget type="SpellWidget" skin="MW_ItemIconNoShadow" position="-3 -3 27 27" align="Center Center" name="SpellImage"/>
                </Widget>
            </Widget>
        </Widget>

        <Widget type="Button" skin="" position="35 166 210 18" align="Center Bottom" name="HealthFrame">
            <UserString key="ToolTipType" value="Layout"/>
            <UserString key="ToolTipLayout" value="HealthToolTip"/>
            <UserString key="ImageTexture_HealthImage" value="icons\k\health.dds"/>
            <Widget type="Widget" skin="MW_Box" position="0 0 210 18" align="Stretch" name="HealthBorder">
                <Widget type="ProgressBar" skin="MW_EnergyBar_Red" position="2 2 206 14" align="Stretch" name="Health">
                    <Property key="NeedMouse" value="false"/>
                </Widget>
                <Widget type="TextBox" skin="SandBrightText" position="0 0 210 18" align="Stretch" name="HealthText">
                    <Property key="NeedMouse" value="false"/>
                    <Property key="TextAlign" value="Center"/>
                    <Property key="TextShadow" value="true"/>
                    <Property key="TextShadowColour" value="0 0 0"/>
                    <Property key="Caption" value="0/0"/>
                </Widget>
            </Widget>
        </Widget>

        <Widget type="Widget" skin="" position="35 188 210 8" align="Center Bottom" name="DrowningFrame">
            <Property key="Visible" value="false"/>
            <Widget type="Widget" skin="MW_Box" position="0 0 210 8" align="Stretch" name="DrowningBorder">
                <Widget type="ProgressBar" skin="MW_Progress_Drowning_Full" position="2 2 206 4" align="Stretch" name="Drowning">
                    <Property key="NeedMouse" value="false"/>
                </Widget>
                <Widget type="Widget" skin="MW_Progress_Drowning_Small" position="2 2 206 4" align="Stretch" name="Flash"/>
            </Widget>
        </Widget>

        <Widget type="Button" skin="" position="10 170 200 28" align="Right Bottom" name="FatigueFrame">
            <UserString key="ToolTipType" value="Layout"/>
            <UserString key="ToolTipLayout" value="HealthToolTip"/>
            <UserString key="ImageTexture_HealthImage" value="icons\k\fatigue.dds"/>

            <Widget type="Widget" skin="MW_Box" position="30 0 170 16" align="Left Bottom" name="FatigueBorder">
